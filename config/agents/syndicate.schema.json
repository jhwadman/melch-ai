{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "syndicate_name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name for this syndicate."
    },
    "orchestrator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$",
          "description": "Unique agent name within the tree. A valid identifier; cannot be \"user\"."
        },
        "description": {
          "description": "One line other agents read to decide when to delegate here.",
          "type": "string"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Model id; its prefix picks the provider (gemini-*, claude-*, gpt-*/o*, grok-*, ollama/*)."
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "System prompt / persona."
        },
        "globalInstruction": {
          "description": "Instruction applied to every agent in the tree; only the root agent's value takes effect.",
          "type": "string"
        },
        "tools": {
          "description": "Named tools from lib/toolRegistry.ts (e.g. web_search, web_extract, wiki_search).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_approval": {
          "description": "Tools from this agent's `tools` that run only after a person approves the exact call (ADR 0028): the A2A task ends input-required until the caller answers approve or reject. Allowed on the orchestrator and on plan-dispatch routes.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "includeContents": {
          "description": "\"default\" = include conversation history, \"none\" = stateless.",
          "type": "string",
          "enum": [
            "default",
            "none"
          ]
        },
        "disallowTransferToParent": {
          "type": "boolean"
        },
        "disallowTransferToPeers": {
          "type": "boolean"
        },
        "outputKey": {
          "description": "Session-state key the final reply is saved under.",
          "type": "string"
        },
        "generateContentConfig": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number"
            },
            "topP": {
              "type": "number"
            },
            "topK": {
              "type": "number"
            },
            "maxOutputTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "stopSequences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "candidateCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "presencePenalty": {
              "type": "number"
            },
            "frequencyPenalty": {
              "type": "number"
            },
            "seed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "responseMimeType": {
              "type": "string"
            },
            "safetySettings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string"
                  },
                  "threshold": {
                    "type": "string"
                  }
                },
                "required": [
                  "category",
                  "threshold"
                ],
                "additionalProperties": {}
              }
            },
            "thinkingConfig": {
              "type": "object",
              "properties": {
                "thinkingBudget": {
                  "description": "Reasoning token budget. 0 = off, -1 = dynamic.",
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "includeThoughts": {
                  "description": "Stream the thinking trace in the response.",
                  "type": "boolean"
                }
              },
              "additionalProperties": {},
              "description": "Gemini thinking controls (generateContentConfig.thinkingConfig)."
            }
          },
          "additionalProperties": {},
          "description": "Model generation config (@google/genai GenerateContentConfig). Do not set tools here."
        },
        "outputSchema": {
          "description": "JSON Schema for structured output. Cannot be combined with AgentTool delegation.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "mcp_server_url": {
          "description": "MCP server (SSE) whose tools are discovered at runtime and merged with `tools`.",
          "type": "string"
        },
        "skills": {
          "type": "object",
          "properties": {
            "dir": {
              "type": "string",
              "minLength": 1,
              "description": "A directory of skills: one subdirectory per skill, named as its SKILL.md frontmatter names it. Relative to the working directory."
            },
            "scripts": {
              "description": "Whether a skill's scripts/ may run. \"local\" runs them on this machine, each after a person approves (ADR 0028); default \"none\".",
              "type": "string",
              "enum": [
                "none",
                "local"
              ]
            },
            "tools": {
              "description": "Registry tool names a skill may unlock through its `allowed-tools` frontmatter once it is loaded. Omitted, no skill unlocks anything.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "dir"
          ],
          "additionalProperties": false,
          "description": "Agent Skills (SKILL.md directories) this agent reads the way a coding harness does."
        },
        "openapi": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "spec": {
                "type": "string",
                "minLength": 1,
                "description": "An OpenAPI 3 spec file (.yaml, .yml, .json), relative to this syndicate file. Files only, never URLs."
              },
              "operations": {
                "description": "Operations to expose, by operationId or tool name. Omitted: every GET operation, and nothing that writes.",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "base_url": {
                "description": "Overrides the spec's servers[0].url. Checked by the SSRF guard.",
                "type": "string",
                "format": "uri"
              },
              "prefix": {
                "description": "Prepended to each tool name, to keep two APIs apart.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "auth": {
                "description": "Credentials, always from the environment, never written in YAML.",
                "type": "object",
                "properties": {
                  "bearer_env": {
                    "description": "Environment variable holding a bearer token.",
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]*$"
                  },
                  "api_key": {
                    "description": "An API key read from `env`, sent in a header or the query under `name`.",
                    "type": "object",
                    "properties": {
                      "env": {
                        "type": "string",
                        "pattern": "^[A-Z_][A-Z0-9_]*$"
                      },
                      "in": {
                        "type": "string",
                        "enum": [
                          "header",
                          "query"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "env",
                      "in",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "spec"
            ],
            "additionalProperties": false,
            "description": "An HTTP API as tools, from its OpenAPI spec (lib/tools/openapiTools.ts)."
          }
        },
        "orchestration": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "primary",
                "sub-agent"
              ]
            },
            "delegates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "model",
        "instruction"
      ],
      "additionalProperties": false,
      "description": "The root agent (ADK LlmAgentConfig)."
    },
    "subagents": {
      "description": "The orchestrator's team. Omit it (or write `subagents: []`) for a single-agent syndicate.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$",
            "description": "Unique agent name within the tree. A valid identifier; cannot be \"user\"."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Required: the orchestrator reads it to decide when to call this subagent."
          },
          "model": {
            "description": "Model id. Inherits the orchestrator's when omitted.",
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "description": "System prompt / persona."
          },
          "globalInstruction": {
            "description": "Instruction applied to every agent in the tree; only the root agent's value takes effect.",
            "type": "string"
          },
          "tools": {
            "description": "Named tools from lib/toolRegistry.ts (e.g. web_search, web_extract, wiki_search).",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "require_approval": {
            "description": "Tools from this agent's `tools` that run only after a person approves the exact call (ADR 0028): the A2A task ends input-required until the caller answers approve or reject. Allowed on the orchestrator and on plan-dispatch routes.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "includeContents": {
            "description": "\"default\" = include conversation history, \"none\" = stateless.",
            "type": "string",
            "enum": [
              "default",
              "none"
            ]
          },
          "disallowTransferToParent": {
            "type": "boolean"
          },
          "disallowTransferToPeers": {
            "type": "boolean"
          },
          "outputKey": {
            "description": "Session-state key the final reply is saved under.",
            "type": "string"
          },
          "generateContentConfig": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number"
              },
              "topP": {
                "type": "number"
              },
              "topK": {
                "type": "number"
              },
              "maxOutputTokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "stopSequences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "candidateCount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "presencePenalty": {
                "type": "number"
              },
              "frequencyPenalty": {
                "type": "number"
              },
              "seed": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "responseMimeType": {
                "type": "string"
              },
              "safetySettings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string"
                    },
                    "threshold": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "category",
                    "threshold"
                  ],
                  "additionalProperties": {}
                }
              },
              "thinkingConfig": {
                "type": "object",
                "properties": {
                  "thinkingBudget": {
                    "description": "Reasoning token budget. 0 = off, -1 = dynamic.",
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "includeThoughts": {
                    "description": "Stream the thinking trace in the response.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": {},
                "description": "Gemini thinking controls (generateContentConfig.thinkingConfig)."
              }
            },
            "additionalProperties": {},
            "description": "Model generation config (@google/genai GenerateContentConfig). Do not set tools here."
          },
          "outputSchema": {
            "description": "JSON Schema for structured output. Cannot be combined with AgentTool delegation.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "mcp_server_url": {
            "description": "MCP server (SSE) whose tools are discovered at runtime and merged with `tools`.",
            "type": "string"
          },
          "skills": {
            "type": "object",
            "properties": {
              "dir": {
                "type": "string",
                "minLength": 1,
                "description": "A directory of skills: one subdirectory per skill, named as its SKILL.md frontmatter names it. Relative to the working directory."
              },
              "scripts": {
                "description": "Whether a skill's scripts/ may run. \"local\" runs them on this machine, each after a person approves (ADR 0028); default \"none\".",
                "type": "string",
                "enum": [
                  "none",
                  "local"
                ]
              },
              "tools": {
                "description": "Registry tool names a skill may unlock through its `allowed-tools` frontmatter once it is loaded. Omitted, no skill unlocks anything.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "dir"
            ],
            "additionalProperties": false,
            "description": "Agent Skills (SKILL.md directories) this agent reads the way a coding harness does."
          },
          "openapi": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "spec": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An OpenAPI 3 spec file (.yaml, .yml, .json), relative to this syndicate file. Files only, never URLs."
                },
                "operations": {
                  "description": "Operations to expose, by operationId or tool name. Omitted: every GET operation, and nothing that writes.",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "base_url": {
                  "description": "Overrides the spec's servers[0].url. Checked by the SSRF guard.",
                  "type": "string",
                  "format": "uri"
                },
                "prefix": {
                  "description": "Prepended to each tool name, to keep two APIs apart.",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "auth": {
                  "description": "Credentials, always from the environment, never written in YAML.",
                  "type": "object",
                  "properties": {
                    "bearer_env": {
                      "description": "Environment variable holding a bearer token.",
                      "type": "string",
                      "pattern": "^[A-Z_][A-Z0-9_]*$"
                    },
                    "api_key": {
                      "description": "An API key read from `env`, sent in a header or the query under `name`.",
                      "type": "object",
                      "properties": {
                        "env": {
                          "type": "string",
                          "pattern": "^[A-Z_][A-Z0-9_]*$"
                        },
                        "in": {
                          "type": "string",
                          "enum": [
                            "header",
                            "query"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "env",
                        "in",
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "spec"
              ],
              "additionalProperties": false,
              "description": "An HTTP API as tools, from its OpenAPI spec (lib/tools/openapiTools.ts)."
            }
          },
          "orchestration": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "sub-agent"
                ]
              },
              "delegates": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "yaml_reference": {
            "description": "A whole nested syndicate (filename under the agents dir) used as this subagent.",
            "type": "string",
            "minLength": 1
          },
          "a2a_agent_url": {
            "description": "A remote agent over A2A: the server base URL or its agent-card URL. Needs no model or instruction; credentials come from A2A_AGENT_TOKENS, never YAML.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false,
        "description": "A subagent: an inline agent, a nested syndicate (yaml_reference), or a remote A2A agent (a2a_agent_url).",
        "anyOf": [
          {
            "required": [
              "instruction"
            ]
          },
          {
            "required": [
              "yaml_reference"
            ]
          },
          {
            "required": [
              "a2a_agent_url"
            ]
          }
        ],
        "not": {
          "required": [
            "yaml_reference",
            "a2a_agent_url"
          ]
        }
      }
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "default_route": {
          "type": "string",
          "minLength": 1,
          "description": "Subagent used whenever routing yields no usable answer. Must name a declared subagent."
        },
        "route_key": {
          "description": "JSON property holding the chosen route. Default \"route\".",
          "type": "string"
        },
        "reason_key": {
          "description": "JSON property holding the justification. Default \"reason\".",
          "type": "string"
        },
        "route_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "minLength": 1,
                "description": "Subagent to run on a match."
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "description": "JS regular expression source tested against the raw message."
              },
              "flags": {
                "description": "Regex flags. Default \"i\".",
                "type": "string"
              },
              "reason": {
                "description": "Shown to the waiting user as the [STATUS] route note.",
                "type": "string"
              }
            },
            "required": [
              "route",
              "pattern"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "default_route"
      ],
      "additionalProperties": false,
      "description": "Opts into PLAN-DISPATCH orchestration (lib/dispatch.ts)."
    },
    "workflow": {
      "type": "object",
      "properties": {
        "edges": {
          "minItems": 1,
          "type": "array",
          "items": {
            "minItems": 2,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Several nodes: fan-out when they follow one node, fan-in when one node follows them."
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  },
                  "description": "A routing map after a node: `{ <route>: <node or nodes>, default: <node> }`, matched against that node's output."
                }
              ]
            }
          },
          "description": "Chains of nodes, each a list; `START` begins at least one. A routing map follows the node whose output it routes."
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ask_user": {
                "description": "Pause and ask the person this; the reply becomes the node's output.",
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "description": "JSON Schema a structured reply to ask_user must satisfy; plain text passes as is.",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "join": {
                "description": "Wait for every predecessor; output `{ <predecessor>: <output> }`.",
                "type": "boolean",
                "const": true
              },
              "map": {
                "description": "Run this agent once per item of a list input, concurrently; output the list of results.",
                "type": "string",
                "minLength": 1
              },
              "max_parallel": {
                "description": "Concurrency of map. Default 8.",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "tool": {
                "description": "Run this registry tool with the node input as its arguments.",
                "type": "string",
                "minLength": 1
              },
              "route_key": {
                "description": "Property of a JSON output holding the route. Default \"route\".",
                "type": "string",
                "minLength": 1
              },
              "retry": {
                "type": "object",
                "properties": {
                  "max_attempts": {
                    "description": "Attempts including the first; 1 = no retry. ADK default 5.",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "initial_delay": {
                    "description": "Seconds before the first retry.",
                    "type": "number",
                    "minimum": 0
                  },
                  "max_delay": {
                    "type": "number",
                    "minimum": 0
                  },
                  "backoff_factor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false,
                "description": "Retry a node on failure (lib/workflow.ts)."
              },
              "timeout": {
                "description": "Seconds this node may run before it fails.",
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false,
            "description": "A declared node (exactly one of ask_user, join, map, tool) or modifiers for an agent node (retry, timeout, route_key)."
          }
        },
        "max_concurrency": {
          "description": "Nodes that may run at once. Default: unbounded.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "edges"
      ],
      "additionalProperties": false,
      "description": "Opts into a WORKFLOW: the syndicate as a graph (lib/workflow.ts). Cannot be combined with dispatch."
    },
    "variables": {
      "description": "Defaults for {{token}} interpolation. {{current_date}} is built in.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "memory_system": {
      "description": "Persistence and semantic-memory layer.",
      "type": "string",
      "enum": [
        "internal-only",
        "session-only",
        "long-term"
      ]
    },
    "guards": {
      "description": "Post-answer guards by name (lib/guards/index.ts).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "memory_namespace": {
      "description": "Where long-term memory is stored: the syndicate name plus a generated id, written once and never recomputed (ADR 0020). Syndicates that declare the same namespace share memory.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,96}$"
    },
    "memory_extraction_rules": {
      "description": "Domain rules appended to the fact-extraction prompt (long-term memory only).",
      "type": "string"
    },
    "memory_extraction_model": {
      "description": "The model that distils this syndicate's turns into memory records; default MEMORY_EXTRACTION_MODEL (ADR 0020).",
      "type": "string",
      "minLength": 1
    },
    "memory_retention_days": {
      "description": "Days a memory fact is kept in this syndicate's namespace; older facts are deleted daily. Needs memory_namespace (ADR 0020).",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "max_steps": {
